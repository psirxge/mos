# Google Sheets конфигурация
# Получите ID таблицы из URL: https://docs.google.com/spreadsheets/d/{GOOGLE_SHEET_ID}/edit
GOOGLE_SHEET_ID=1IPSrwsLZvL8vqwW_Hk5cv0rUl6mAtLMzdhGShaLGYaw

# Путь к файлу с учетными данными Google API
# Скачайте credentials.json из Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json

# MOEX конфигурация
# URL базовой страницы Московской Биржи
MOEX_URL=https://www.moex.com/

# Интервал обновления в секундах (600 сек = 10 минут)
UPDATE_INTERVAL=600

# Логирование
LOG_LEVEL=INFO
LOG_FILE=bonds_parser.log
